# r6data.com API key — the bot fetches all R6 stats through this hosted API,
# which handles Ubisoft auth + DataDome on their side.
# Register and create a key at https://r6data.com
R6DATA_API_KEY=

# Discord bot — create an application + bot at https://discord.com/developers
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands instantly to ONE guild (dev). Leave blank
# to register globally (can take up to ~1h to propagate the first time).
GUILD_ID=

# SQLite location (auto-created; directory is made on startup). Stores Discord
# account links only — stats are always fetched live.
DB_PATH=./data/r6bot.db

# Data provider:
#   r6data  (default) — hosted API, works anywhere incl. a VPS.
#   ubisoft           — hybrid: pull the freshest rank/RP/record + account info
#                       straight from Ubisoft via a burner account, keep
#                       operators/seasonal-history/ban on r6data.
# Ubisoft blocks datacenter/VPS IPs (DataDome), so `ubisoft` only works when the
# bot runs from a residential IP (e.g. a self-hosted laptop). r6data is always
# the automatic fallback if a Ubisoft call fails.
R6_PROVIDER=r6data

# Only needed when R6_PROVIDER=ubisoft. Use a BURNER Ubisoft account with 2FA
# DISABLED — never your real account (login automation + ban risk).
UBI_EMAIL=
UBI_PASSWORD=

