# r6data.com API key — the bot fetches all R6 stats through this hosted API,
# which handles Ubisoft auth + DataDome on their side.
# Register and create a key at https://r6data.com
R6DATA_API_KEY=

# Discord bot — create an application + bot at https://discord.com/developers
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register slash commands instantly to ONE guild (dev). Leave blank
# to register globally (can take up to ~1h to propagate the first time).
GUILD_ID=

# SQLite location (auto-created; directory is made on startup). Stores Discord
# account links only — stats are always fetched live from r6data.com.
DB_PATH=./data/r6bot.db

