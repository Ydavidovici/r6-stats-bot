# =============================================================================
#  REQUIRED — the bot won't start without these.
# =============================================================================

# r6data.com API key. Stats are fetched through this hosted API, which handles
# Ubisoft auth + DataDome on their side. Required even in `ubisoft` mode below,
# since operators / seasonal history / ban status always come from r6data.
# Register and create a key at https://r6data.com
R6DATA_API_KEY=

# Discord bot token — create an application + bot at https://discord.com/developers
DISCORD_TOKEN=

# Discord application (client) ID — needed by the slash-command deploy script.
DISCORD_CLIENT_ID=

# =============================================================================
#  OPTIONAL — sensible defaults; leave blank/unset to use them.
# =============================================================================

# Register slash commands instantly to ONE guild (dev). Leave blank to register
# globally (can take up to ~1h to propagate the first time).
GUILD_ID=

# SQLite location (auto-created; directory is made on startup). Stores Discord
# account links only — stats are always fetched live.
DB_PATH=./data/r6bot.db

# Data provider:
#   r6data  (default) — hosted API, works anywhere incl. a VPS.
#   ubisoft           — hybrid: pull the freshest rank/RP/record + account info
#                       straight from Ubisoft via a burner account, keep
#                       operators / seasonal history / ban on r6data.
# Ubisoft blocks datacenter/VPS IPs (DataDome), so `ubisoft` only works when the
# bot runs from a residential IP (e.g. a self-hosted laptop). r6data is always
# the automatic fallback if a Ubisoft call fails.
R6_PROVIDER=r6data

# REQUIRED ONLY IF R6_PROVIDER=ubisoft (ignored otherwise). Use a BURNER Ubisoft
# account with 2FA DISABLED — never your real account (login automation + ban
# risk). The bot exits on startup if these are missing while ubisoft is selected.
UBI_EMAIL=
UBI_PASSWORD=
